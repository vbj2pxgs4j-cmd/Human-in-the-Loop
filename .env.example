# Application Environment
ENVIRONMENT=development
DEBUG=True

# API Gateway
API_HOST=0.0.0.0
API_PORT=8000

# Corpus & Retrieval Paths
CORPUS_DATA_DIR=data/corpus
INDEX_CACHE_DIR=data/index
VECTOR_INDEX_PATH=data/index/corpus_index.pkl

# Embedding & Search Models
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_SIMILARITY_THRESHOLD=0.72
CANONICAL_SIMILARITY_THRESHOLD=0.88
HYBRID_BM25_WEIGHT=0.4
HYBRID_DENSE_WEIGHT=0.6

# System Constraints & Caps
RESPONSE_MAX_SENTENCES=3
WEEKLY_PULSE_MAX_WORDS=250
EXPLAINER_MAX_BULLETS=6
EXPLAINER_MIN_LINKS=2
MAX_THEMES_CAP=5
TOP_THEMES_COUNT=3
FREQUENCY_ESCALATION_THRESHOLD=5

# Audit & Storage
AUDIT_LOG_PATH=data/audit_diff_log.json

# API Security
SUPPORT_API_KEY=hitl_live_sk_7f8a9b2c3d4e5f6a1b2c3d4e5f6a7b8c
